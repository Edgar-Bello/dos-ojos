# Copy this to farm_data\sms\sms.env and fill it in yourself. That file is read by
# dosojos-sms and never committed; the program never writes keys anywhere.
# With no Twilio lines at all, texts stay on this computer (simulator and 'chat').

# From the Twilio console, Account Info:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The number farmers text (+1956...), or a Messaging Service id (MG...) instead:
TWILIO_FROM=
# TWILIO_MESSAGING_SERVICE_SID=

# The https address the tunnel or host gives this server; links in texts use it,
# and Twilio's webhook must be set to <this>/sms/twilio.
DOSOJOS_PUBLIC_URL=

# Put at the end of the HELP text, e.g. a phone number farmers can call:
# DOSOJOS_TEAM_CONTACT=Edgar 956-555-0100
